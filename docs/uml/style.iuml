  BackgroundColor #F7F9FC
  BorderColor #3B4A63
  ArrowColor #3B4A63
  StereotypeFontSize 11
}
skinparam package {
  BorderColor #8A97AD
  FontColor #3B4A63
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #B8A86A
}
