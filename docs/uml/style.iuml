skinparam defaultFontName "DejaVu Sans Condensed"
skinparam dpi 200
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundCorner 4
skinparam packageStyle rectangle
